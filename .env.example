# Roost environment variables.
# Copy to .env for local development. All variables are validated at boot by
# src/lib/env.ts — a missing or malformed value fails fast with a clear error.

# --- App ---
# Public origin. Must be the real domain in production: Better Auth derives
# its baseURL and OAuth redirect URIs from it, and secure cookies switch on
# automatically when this is https.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (required) ---
# PostgreSQL connection string (postgres:// or postgresql://).
# pgvector is required from Milestone 4 onward.
DATABASE_URL=postgresql://postgres@localhost:5432/roost

# --- Auth (required) ---
# Signing key for sessions and tokens. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Google OAuth (optional) ---
# When both are set, the "Continue with Google" button appears automatically.
# Create credentials at https://console.cloud.google.com/apis/credentials and
# set the authorized redirect URI to:
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Email (optional) ---
# Without a key, verification and reset emails print to the server log
# (console transport) — fine for development. Set a Resend key to send real
# mail; EMAIL_FROM must be a verified sender on your domain.
# RESEND_API_KEY=
# EMAIL_FROM=noreply@yourdomain.com

# --- Cache / queues (required) ---
# Used by BullMQ job queues and the shared rate limiter.
REDIS_URL=redis://localhost:6379

# --- Testing ---
# Overrides the database used by the test suite. Defaults to
# postgresql://<you>@localhost:5432/roost_test
# TEST_DATABASE_URL=

# --- Object storage (optional) ---
# With no bucket configured, uploads are written to LOCAL_STORAGE_DIR on disk,
# so local development needs no cloud account. Set all three to switch to
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO).
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # R2/MinIO only
LOCAL_STORAGE_DIR=.storage

# Hard ceiling on a single upload, in megabytes.
MAX_UPLOAD_MB=25

# --- Payments (optional) ---
# Without these, providers cannot connect Stripe and bookings are made
# without payment. Test-mode keys are enough for local development:
#   https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret. Locally, `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` prints one.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Roost's cut in basis points (800 = 8%). Must match docs/pricing and
# src/lib/plans.ts, which the pricing page reads.
# PLATFORM_FEE_BPS=800

# --- Subscriptions (optional) ---
# Stripe Billing price IDs for the platform subscription (Roost charges the
# provider). Both *_MONTHLY prices enable checkout; the annual prices are
# optional. Without them, /settings/billing shows a read-only "not available"
# state. Create the products/prices in the same Stripe account as the key
# above. See docs/subscriptions.md.
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_ANNUAL=price_...
