# Dependencies and build output are produced inside the image.
node_modules
.next
.turbo

# Local-only state that must never enter an image.
.env
.env.*
.storage
*.log

# VCS, CI, editor, and test noise irrelevant to the runtime.
.git
.github
.vscode
.idea
coverage
**/*.test.ts
**/*.test.tsx
**/*.integration.test.ts

# Docs and meta.
*.md
docs
