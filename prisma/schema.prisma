// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// NOTE: the auth models below (User, Session, Account, Verification) are
// generated by `npx @better-auth/cli generate`, which OVERWRITES this file.
// The domain models and the User back-relations marked below are hand-written
// — re-add them after any regeneration. See docs/database.md.
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // --- hand-written domain back-relations ---
  memberships BusinessMember[]
  bookings    Booking[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────────────────
// Domain models (hand-written — see the note on User above)
// ─────────────────────────────────────────────────────────────────────────

/// Seat role within one business. Owners can never be removed or demoted by
/// another member; that guarantee is enforced in the service layer.
enum BusinessRole {
  OWNER
  ADMIN
  MEMBER
}

enum BusinessStatus {
  /// Being set up; not publicly listed.
  DRAFT
  /// Submitted for verification of licence and insurance.
  PENDING_REVIEW
  /// Verified and listed on the marketplace.
  ACTIVE
  /// Hidden from the marketplace by an admin.
  SUSPENDED
}

/// A home-service business — the provider side of the marketplace and the
/// tenant boundary for all operational data (jobs, quotes, clients).
model Business {
  id      String  @id @default(cuid())
  /// URL segment for the public storefront: /pro/<slug>.
  slug    String  @unique
  name    String
  tagline String?
  about   String?
  phone   String?
  email   String?
  website String?
  /// Storage key for the logo; served through the storage driver.
  logoKey String?

  status       BusinessStatus @default(DRAFT)
  /// Set when licence and insurance documents have been checked.
  verifiedAt   DateTime?
  /// Expiry of the insurance certificate on file; drives re-verification.
  insuredUntil DateTime?

  /// Connected Stripe account (Express). Null until the owner starts
  /// onboarding; the three flags mirror Stripe and are only ever written from
  /// a verified webhook or an explicit refresh.
  stripeAccountId        String? @unique
  stripeChargesEnabled   Boolean @default(false)
  stripePayoutsEnabled   Boolean @default(false)
  stripeDetailsSubmitted Boolean @default(false)

  /// Monotonic invoice counter for this business.
  ///
  /// Incremented with `{ increment: 1 }`, which compiles to an in-place SQL
  /// update and therefore takes a row lock — concurrent invoice creation
  /// serialises on it. Deriving the next number from `MAX(number)` instead
  /// would let simultaneous writers read the same maximum.
  invoiceCounter Int @default(0)

  /// IANA zone. Opening hours are wall-clock times in this zone, so every
  /// instant shown to a customer is derived from it.
  timezone           String @default("America/Vancouver")
  /// How much notice the business needs before a job starts.
  bookingLeadHours   Int    @default(24)
  /// How far ahead customers may book.
  bookingHorizonDays Int    @default(30)

  members                BusinessMember[]
  bookings               Booking[]
  quotes                 Quote[]
  invoices               Invoice[]
  categories             BusinessCategory[]
  serviceAreas           ServiceArea[]
  documents              BusinessDocument[]
  packages               ServicePackage[]
  hours                  BusinessHour[]
  availabilityExceptions AvailabilityException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("business")
}

/// A person's seat in a business. The subscription tier caps how many of
/// these may exist (1 on Pro, 8 on Premium).
model BusinessMember {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessRole @default(MEMBER)

  assignments Booking[]

  createdAt DateTime @default(now())

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_member")
}

/// A trade the marketplace supports (plumbing, HVAC, interior cleaning, …).
/// Seeded from a fixed list so category pages have stable URLs.
model ServiceCategory {
  id          String  @id @default(cuid())
  /// URL segment: /services/<slug>.
  slug        String  @unique
  name        String
  description String?
  /// Ordering on the browse page; lower sorts first.
  position    Int     @default(0)

  businesses      BusinessCategory[]
  servicePackages ServicePackage[]

  @@map("service_category")
}

model BusinessCategory {
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@index([categoryId])
  @@map("business_category")
}

/// A place a business will travel to. Marketplace search matches on these,
/// which is what makes "no providers serve this city yet" answerable.
model ServiceArea {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  city       String
  /// Province or state code, e.g. "BC".
  region     String
  /// ISO 3166-1 alpha-2, e.g. "CA".
  country    String   @default("CA")

  createdAt DateTime @default(now())

  @@unique([businessId, city, region, country])
  @@index([city, region, country])
  @@map("service_area")
}

enum BusinessDocumentKind {
  /// Trade licence or business registration.
  LICENCE
  /// Certificate of liability insurance.
  INSURANCE
  /// Anything else an admin asked for.
  OTHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A credential a business uploads to be verified. Never publicly readable —
/// only the business and platform admins can fetch the underlying object.
model BusinessDocument {
  id         String               @id @default(cuid())
  businessId String
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       BusinessDocumentKind
  /// Original filename, sanitized — display only, never a path.
  title      String
  storageKey String               @unique
  mimeType   String
  sizeBytes  Int

  status     VerificationStatus @default(PENDING)
  /// Admin-facing reason shown to the business when rejected.
  reviewNote String?
  reviewedAt DateTime?
  /// Expiry printed on the certificate, when applicable.
  expiresAt  DateTime?

  /// Set once the business has been warned this document is about to lapse.
  expiryNoticeSentAt DateTime?

  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId, kind])
  @@index([status])
  @@map("business_document")
}

enum PricingModel {
  /// One upfront price for the whole job — the marketplace default.
  FIXED
  /// Priced per hour; `priceCents` is the hourly rate.
  HOURLY
  /// Needs a site visit before a number can be given.
  QUOTE
}

/// Something a customer can actually book: a named service with a price and
/// a duration. Duration is what makes a calendar slot, so it is required even
/// for quote-priced work.
model ServicePackage {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Optional link to the trade taxonomy, for marketplace filtering.
  categoryId  String?
  category    ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  pricingModel    PricingModel @default(FIXED)
  /// Null only when `pricingModel` is QUOTE. Integer cents — never a float.
  priceCents      Int?
  /// Minutes of work; drives slot length.
  durationMinutes Int
  /// Travel or clean-up time reserved after the job, not shown as bookable.
  bufferMinutes   Int          @default(0)

  active   Boolean @default(true)
  position Int     @default(0)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, active])
  @@map("service_package")
}

/// One opening window on one weekday. A day may have several rows, which is
/// how split shifts (08:00–12:00, 13:00–17:00) are represented.
model BusinessHour {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday, matching `Date.prototype.getDay`.
  weekday     Int
  /// Minutes from midnight, wall-clock in the business's timezone.
  startMinute Int
  endMinute   Int

  @@unique([businessId, weekday, startMinute])
  @@index([businessId])
  @@map("business_hour")
}

/// A day the business is closed regardless of its weekly hours — holidays,
/// vacation, a booked-out day.
model AvailabilityException {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Calendar date in the business's timezone, stored without a time part.
  date       DateTime @db.Date
  note       String?

  createdAt DateTime @default(now())

  @@unique([businessId, date])
  @@map("availability_exception")
}

enum BookingStatus {
  /// Requested by a customer, not yet accepted by the business.
  PENDING
  /// Accepted; the business is committed to showing up.
  CONFIRMED
  /// The business turned it down.
  DECLINED
  /// Called off by either side after it was requested.
  CANCELLED
  /// The work happened.
  COMPLETED
}

/// A customer's request for a specific service at a specific time.
///
/// Service details are *copied* onto the booking rather than referenced,
/// because a business may reprice or delete a package afterwards and neither
/// should rewrite history. `packageId` is kept only as a soft link.
model Booking {
  id         String   @id @default(cuid())
  /// Short human-quotable code; the customer's only handle on the booking.
  reference  String   @unique
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  packageId       String?
  package         ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  /// Snapshot of the service as sold.
  packageName     String
  pricingModel    PricingModel
  priceCents      Int?
  durationMinutes Int

  /// Stored WITH a zone. These are instants, and `booking_no_overlap` builds
  /// a `tstzrange` over them — over a zone-less `timestamp` that expression
  /// is not immutable and Postgres refuses to index it. Removing these
  /// attributes silently drops the double-booking guarantee.
  startAt  DateTime @db.Timestamptz(3)
  /// Always `startAt + durationMinutes`; stored so the database can enforce
  /// non-overlap without recomputing it.
  endAt    DateTime @db.Timestamptz(3)
  /// The business's timezone when booked, so the time can be redisplayed
  /// exactly as the customer saw it.
  timezone String

  status BookingStatus @default(PENDING)

  /// Marketplace customers need not have an account; the account link is set
  /// when they happened to be signed in.
  userId        String?
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String
  customerPhone String

  addressLine1 String
  addressLine2 String?
  city         String
  region       String
  postalCode   String
  notes        String?

  /// Which team member is doing the work. Null means "unassigned", which on
  /// a solo business is the normal state.
  assignedToId String?
  assignedTo   BusinessMember? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  /// Free text the customer never sees: parking, equipment, warnings.
  internalNote String?

  /// Set once the pre-visit reminder has gone out. The reminder sweep is
  /// idempotent on this, so a restarted worker cannot mail twice.
  reminderSentAt DateTime?

  cancelledAt        DateTime?
  cancellationReason String?
  respondedAt        DateTime?

  payment Payment?
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, startAt])
  @@index([customerEmail])
  @@index([status])
  @@index([assignedToId])
  @@map("booking")
}

enum PaymentStatus {
  /// Checkout session created; the customer has not finished paying.
  PENDING
  /// Stripe confirmed the funds. The only status that means money moved.
  SUCCEEDED
  /// The customer's payment failed or they abandoned checkout.
  FAILED
  /// Money returned, in full or in part. `refundedCents` says how much.
  REFUNDED
}

/// Money for one booking.
///
/// Amounts are copied from the booking at checkout: a business repricing a
/// service must not change what was actually charged. Stripe remains the
/// source of truth for whether funds moved — every status change here is
/// driven by a verified webhook, never by the browser returning from
/// checkout.
model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// Set before redirecting the customer; unique so a retry cannot duplicate.
  stripeCheckoutSessionId String  @unique
  stripePaymentIntentId   String? @unique
  /// The connected account the funds settle into.
  stripeAccountId         String

  /// What the customer is charged, in the smallest currency unit.
  amountCents      Int
  /// Roost's cut, taken from `amountCents` via Stripe's application fee.
  platformFeeCents Int
  currency         String @default("cad")

  status        PaymentStatus @default(PENDING)
  refundedCents Int           @default(0)
  failureReason String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payment")
}

/// Every Stripe event we have already handled.
///
/// Stripe retries deliveries and does not promise exactly-once, so the event
/// id is the primary key and insertion is the idempotency check: a duplicate
/// delivery collides and is skipped rather than refunding twice.
model StripeWebhookEvent {
  /// Stripe's own event id (`evt_…`).
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_webhook_event")
}

enum QuoteStatus {
  /// Being written; the customer cannot see it.
  DRAFT
  /// Sent and awaiting an answer.
  SENT
  /// The customer said yes.
  ACCEPTED
  /// The customer said no.
  DECLINED
  /// `validUntil` passed without an answer.
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  /// Cancelled after issue. Kept, never deleted — an issued invoice is a
  /// record even when it is withdrawn.
  VOID
}

/// A priced proposal for work that could not be fixed-priced up front.
///
/// Customer details are copied rather than referenced: a quote is a document
/// as it was sent, and editing a client record later must not silently
/// rewrite what someone agreed to.
model Quote {
  id         String   @id @default(cuid())
  /// Public handle, same alphabet and guarantees as a booking reference.
  reference  String   @unique
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  title        String
  /// Shown to the customer.
  notes        String?
  /// Never shown to the customer.
  internalNote String?

  customerName  String
  customerEmail String
  customerPhone String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  region        String?
  postalCode    String?

  status     QuoteStatus @default(DRAFT)
  /// After this the quote is stale; the sweep marks it EXPIRED.
  validUntil DateTime?   @db.Timestamptz(3)

  /// Totals are derived from the lines but stored, so a historical document
  /// keeps the numbers it was sent with even if the maths ever changes.
  subtotalCents Int @default(0)
  taxRateBps    Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)
  /// Optional up-front payment required to schedule the work.
  depositCents  Int @default(0)

  lines QuoteLine[]

  /// Set when accepting produced an invoice.
  invoice Invoice?

  sentAt        DateTime?
  respondedAt   DateTime?
  declineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([customerEmail])
  @@map("quote")
}

model QuoteLine {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  description        String
  /// Hundredths of a unit, so "2.5 hours" is 250. Integer arithmetic only —
  /// a quantity stored as a float would round money wrong.
  quantityHundredths Int    @default(100)
  unitPriceCents     Int
  position           Int    @default(0)

  @@index([quoteId])
  @@map("quote_line")
}

/// A demand for payment. Issued from a quote, a booking, or on its own.
model Invoice {
  id         String   @id @default(cuid())
  reference  String   @unique
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Sequential per business, for the customer's records and the provider's
  /// bookkeeping. Unique per business, never reused.
  number Int

  quoteId   String?  @unique
  quote     Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  /// The job this bills for, when there is one.
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  title String
  notes String?

  customerName  String
  customerEmail String
  customerPhone String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  region        String?
  postalCode    String?

  status InvoiceStatus @default(DRAFT)
  dueAt  DateTime?     @db.Timestamptz(3)

  subtotalCents   Int @default(0)
  taxRateBps      Int @default(0)
  taxCents        Int @default(0)
  totalCents      Int @default(0)
  /// Sum of settled payments. Below `totalCents` means part-paid.
  amountPaidCents Int @default(0)

  lines InvoiceLine[]

  /// Stripe Checkout for this invoice, when one has been started.
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?   @unique
  sentAt                  DateTime?
  paidAt                  DateTime?
  voidedAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([customerEmail])
  @@map("invoice")
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description        String
  quantityHundredths Int    @default(100)
  unitPriceCents     Int
  position           Int    @default(0)

  @@index([invoiceId])
  @@map("invoice_line")
}
